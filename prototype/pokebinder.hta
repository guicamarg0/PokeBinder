<html>
<head>
  <meta http-equiv="x-ua-compatible" content="IE=9" />
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <title>PokeBinder — Protótipo</title>
  <HTA:APPLICATION
    ID="PokeBinderPrototype"
    APPLICATIONNAME="PokeBinder"
    BORDER="thin"
    CAPTION="yes"
    MAXIMIZEBUTTON="yes"
    MINIMIZEBUTTON="yes"
    SCROLL="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
  />
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; background: #fbfbfc; color: #171b25; font-family: Arial, sans-serif; }
    body { padding-bottom: 86px; }
    button, input, select { font: inherit; }
    button { cursor: pointer; }
    .topbar { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; justify-content: space-between; padding: 20px 34px; background: rgba(255,255,255,.96); border-bottom: 1px solid #ececef; }
    .brand { font-size: 25px; font-weight: 900; letter-spacing: -1.5px; }
    .brand span, .red { color: #d92735; }
    .tagline { margin-top: 4px; color: #858b96; font-size: 12px; }
    .notice { position: relative; width: 42px; height: 42px; border: 0; border-radius: 50%; background: #f1f2f4; color: #747b85; font-size: 20px; }
    .notice b { position: absolute; right: 8px; top: 7px; width: 8px; height: 8px; border-radius: 50%; background: #d92735; }
    .page { width: min(1100px, calc(100% - 48px)); margin: 0 auto; padding-top: 32px; }
    .screen { display: none; }
    .screen.active { display: block; }
    h1 { margin: 4px 0 8px; font-size: 40px; letter-spacing: -1.8px; }
    h2 { margin: 0; font-size: 24px; letter-spacing: -.8px; }
    p { margin: 0; }
    .eyebrow { color: #d92735; font-size: 14px; font-weight: 800; }
    .muted { color: #818793; }
    .row { display: flex; align-items: center; justify-content: space-between; gap: 18px; }
    .hero { display: flex; align-items: center; gap: 28px; margin-top: 26px; padding: 30px; border: 1px solid #f1dfe1; border-radius: 28px; background: linear-gradient(135deg, #fff6f7, #fff); }
    .pokeball { position: relative; width: 132px; height: 132px; flex: 0 0 auto; overflow: hidden; border: 8px solid #252a34; border-radius: 50%; background: linear-gradient(#e44750 0 47%, #252a34 47% 54%, #fff 54%); box-shadow: 0 12px 26px rgba(217,39,53,.2); }
    .pokeball:after { content: ""; position: absolute; left: 50%; top: 50%; width: 40px; height: 40px; transform: translate(-50%, -50%); border: 8px solid #252a34; border-radius: 50%; background: white; }
    .metrics { display: flex; align-items: center; gap: 18px; margin-top: 14px; }
    .metric strong { color: #d92735; font-size: 42px; }
    .metric span { color: #818793; font-size: 14px; font-weight: bold; }
    .divider { width: 1px; height: 42px; background: #eadbdd; }
    .primary, .secondary { border-radius: 14px; padding: 13px 18px; font-weight: 800; }
    .primary { border: 0; background: #d92735; color: white; box-shadow: 0 8px 18px rgba(217,39,53,.16); }
    .secondary { border: 1px solid #eadde0; background: white; color: #5d6572; }
    .hero .primary { white-space: nowrap; }
    .quick-grid, .card-grid, .binder-grid, .offer-grid, .stat-grid { display: grid; gap: 14px; }
    .quick-grid { grid-template-columns: repeat(3, 1fr); margin-top: 18px; }
    .quick, .panel, .binder, .offer, .stat { border: 1px solid #edf0f3; border-radius: 20px; background: white; box-shadow: 0 5px 16px rgba(15,23,42,.04); }
    .quick { display: flex; align-items: center; gap: 12px; padding: 16px; text-align: left; }
    .quick-icon { display: flex; width: 42px; height: 42px; align-items: center; justify-content: center; border-radius: 14px; background: #fff0f1; color: #d92735; font-size: 23px; }
    .quick strong, .card-title, .binder-title { display: block; font-weight: 900; }
    .quick small, .binder small { display: block; margin-top: 5px; color: #818793; font-size: 12px; }
    .section { margin-top: 32px; }
    .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
    .link { border: 0; background: transparent; color: #d92735; font-weight: 800; }
    .activity-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .panel { padding: 18px; }
    .activity-dot { display: inline-block; width: 9px; height: 9px; margin-bottom: 12px; border-radius: 50%; background: #d92735; }
    .activity-title { font-size: 13px; font-weight: 900; }
    .activity-text { margin-top: 6px; color: #818793; font-size: 12px; line-height: 1.5; }
    .bottom-nav { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: flex; justify-content: center; gap: 12px; padding: 12px 20px; border-top: 1px solid #ececef; background: rgba(255,255,255,.97); }
    .nav-button { min-width: 96px; border: 0; border-radius: 14px; background: transparent; color: #7d8490; padding: 7px 13px; font-size: 12px; font-weight: 800; }
    .nav-button .nav-icon { display: block; margin-bottom: 4px; font-size: 22px; }
    .nav-button.active { color: #d92735; }
    .binder-grid { grid-template-columns: repeat(3, 1fr); margin-top: 22px; }
    .binder { overflow: hidden; }
    .binder-cover { display: flex; height: 156px; align-items: center; justify-content: center; background: linear-gradient(135deg, #d92735, #f5b8bc); }
    .binder-cover.yellow { background: linear-gradient(135deg, #eab52a, #fff1a9); }
    .binder-cover.blue { background: linear-gradient(135deg, #7198c8, #d7e6fb); }
    .cover-ball { width: 72px; height: 72px; border: 5px solid white; border-radius: 50%; background: linear-gradient(#ef5350 0 44%, #252a34 44% 56%, #fff 56%); }
    .binder-body { padding: 16px; }
    .binder-actions { display: flex; gap: 8px; margin-top: 14px; }
    .binder-actions button { flex: 1; }
    .add-tile { min-height: 235px; border: 2px dashed #f0c9cd; border-radius: 20px; background: #fff7f7; color: #d92735; }
    .add-tile span { display: block; font-size: 42px; }
    .add-tile b { display: block; margin-top: 10px; }
    .stat-grid { grid-template-columns: repeat(3, 1fr); margin: 22px 0; }
    .stat { padding: 20px; }
    .stat strong { display: block; color: #d92735; font-size: 32px; }
    .stat:first-child { background: #d92735; color: white; }
    .stat:first-child strong { color: white; }
    .tabs { display: flex; gap: 8px; overflow: auto; margin: 12px 0 18px; }
    .tab { white-space: nowrap; border: 0; border-radius: 99px; background: white; color: #707887; padding: 10px 15px; font-size: 12px; font-weight: 800; }
    .tab.active { background: #d92735; color: white; }
    .offer-grid { grid-template-columns: repeat(3, 1fr); }
    .offer { padding: 18px; }
    .person { display: flex; align-items: center; gap: 10px; }
    .avatar { display: flex; width: 38px; height: 38px; align-items: center; justify-content: center; border-radius: 50%; background: #ffe3e5; color: #c92130; font-size: 12px; font-weight: 900; }
    .exchange { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 10px; margin: 18px 0; }
    .trade-card { display: flex; height: 100px; align-items: center; justify-content: center; border: 4px solid #e7693d; border-radius: 12px; background: linear-gradient(135deg, #fff, #f1f3f5); color: #d92735; font-size: 30px; font-weight: 900; }
    .profile-card { display: flex; align-items: center; gap: 22px; padding: 26px; border: 1px solid #f1dfe1; border-radius: 25px; background: linear-gradient(135deg, #fff6f7, #fff); }
    .profile-avatar { display: flex; width: 92px; height: 92px; align-items: center; justify-content: center; border-radius: 50%; background: #d92735; color: white; font-size: 38px; font-weight: 900; }
    .profile-stats { display: flex; gap: 22px; margin-top: 15px; }
    .profile-stats strong { display: block; font-size: 22px; }
    .profile-stats small { color: #818793; }
    .profile-columns { display: grid; grid-template-columns: 1.1fr .9fr; gap: 16px; margin-top: 18px; }
    .friend { display: flex; align-items: center; gap: 11px; padding: 11px; border-radius: 13px; background: #f7f8fa; }
    .friend + .friend { margin-top: 9px; }
    .friend div:nth-child(2) { flex: 1; }
    .toggle-row { display: flex; align-items: center; justify-content: space-between; padding: 14px 0; border-bottom: 1px solid #f0f1f3; font-size: 13px; font-weight: 800; }
    .switch { width: 38px; height: 22px; padding: 3px; border-radius: 99px; background: #d92735; }
    .switch i { display: block; width: 16px; height: 16px; margin-left: 16px; border-radius: 50%; background: white; }
    .modal-bg { position: fixed; inset: 0; z-index: 40; display: flex; align-items: flex-end; justify-content: center; padding: 14px; background: rgba(17,20,29,.48); }
    .modal { width: min(640px, 100%); max-height: 90vh; overflow: auto; border-radius: 25px 25px 12px 12px; background: white; padding: 25px; box-shadow: 0 24px 70px rgba(15,23,42,.3); }
    .modal-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
    .close { width: 36px; height: 36px; border: 0; border-radius: 50%; background: #f1f2f4; color: #66707b; font-size: 22px; }
    .form-row { margin-top: 15px; }
    label { display: block; margin-bottom: 7px; font-size: 13px; font-weight: 900; }
    input, select { width: 100%; border: 1px solid #e2e5e9; border-radius: 12px; background: #fafbfc; padding: 13px; outline: none; }
    .slot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 10px; }
    .slot { aspect-ratio: 1; border: 2px dashed #dfe3e8; border-radius: 12px; background: #fff; color: #cbd0d6; font-size: 24px; }
    .slot.selected { border-style: solid; border-color: #d92735; background: #fff0f1; color: #d92735; }
    .selected-card { display: flex; align-items: center; gap: 14px; margin-top: 16px; padding: 12px; border-radius: 16px; background: #fff0f1; }
    .selected-card .thumb { display: flex; width: 56px; height: 76px; align-items: center; justify-content: center; border: 4px solid #f1bd25; border-radius: 10px; background: #fff; color: #d2a420; font-size: 25px; font-weight: 900; }
    .stepper { display: flex; align-items: center; gap: 10px; }
    .stepper button { width: 36px; height: 36px; border: 0; border-radius: 50%; background: #fff0f1; color: #d92735; font-size: 21px; font-weight: 900; }
    .stepper strong { min-width: 52px; border: 1px solid #e2e5e9; border-radius: 10px; padding: 8px; text-align: center; }
    .modal .primary { width: 100%; margin-top: 18px; }
    .hidden { display: none !important; }
    @media (max-width: 760px) { .page { width: calc(100% - 28px); padding-top: 22px; } h1 { font-size: 31px; } .topbar { padding: 15px 18px; } .hero { flex-direction: column; align-items: flex-start; padding: 22px; } .hero .primary { width: 100%; } .quick-grid, .activity-grid, .binder-grid, .offer-grid, .stat-grid { grid-template-columns: 1fr; } .profile-card, .profile-columns { grid-template-columns: 1fr; flex-direction: column; align-items: flex-start; } .bottom-nav { gap: 0; justify-content: space-around; padding: 9px 4px; } .nav-button { min-width: 70px; } }
  </style>
</head>
<body>
  <header class="topbar"><div><div class="brand">Poke<span>Binder</span></div><div class="tagline">Sua coleção, sempre com você.</div></div><button class="notice">♧<b></b></button></header>
  <main class="page">
    <section id="home" class="screen active">
      <div><p class="eyebrow">Bom dia, Guilherme 👋</p><h1>O que vamos organizar?</h1></div>
      <div class="hero"><div class="pokeball"></div><div style="flex:1"><p class="muted"><b>Resumo da sua coleção</b></p><div class="metrics"><div class="metric"><strong>128</strong><span>cartas</span></div><div class="divider"></div><div class="metric"><strong>3</strong><span>fichários</span></div></div><p class="muted" style="margin-top:8px">Grandes coleções começam com uma única carta.</p></div><button class="primary" onclick="openModal('card')">＋ Adicionar carta</button></div>
      <div class="section"><h2>Acesso rápido</h2><div class="quick-grid"><button class="quick" onclick="navigate('binders')"><span class="quick-icon">▣</span><span><strong>Meus fichários</strong><small>Organize suas páginas</small></span></button><button class="quick" onclick="navigate('trades')"><span class="quick-icon">⇄</span><span><strong>Trocar cartas</strong><small>Encontre novas cartas</small></span></button><button class="quick" onclick="navigate('profile')"><span class="quick-icon">♙</span><span><strong>Adicionar amigos</strong><small>Colecione em comunidade</small></span></button></div></div>
      <div class="section"><div class="section-header"><h2>Atividade recente</h2><button class="link" onclick="navigate('trades')">Ver todas ›</button></div><div class="activity-grid"><div class="panel"><i class="activity-dot"></i><p class="activity-title">Nova oferta recebida</p><p class="activity-text">Marina quer trocar Charizard por Mew ex.</p></div><div class="panel"><i class="activity-dot" style="background:#eab52a"></i><p class="activity-title">Carta adicionada</p><p class="activity-text">Pikachu foi para Coleção principal.</p></div><div class="panel"><i class="activity-dot" style="background:#7198c8"></i><p class="activity-title">Novo amigo</p><p class="activity-text">Você e Lucas agora são amigos.</p></div></div></div>
    </section>

    <section id="binders" class="screen"><div class="row"><div><p class="eyebrow">Sua organização</p><h1>Meus fichários</h1><p class="muted">Cada carta no seu lugar, do seu jeito.</p></div><button class="primary" onclick="openModal('binder')">＋ Novo fichário</button></div><div class="binder-grid"><div class="binder"><div class="binder-cover"><div class="cover-ball"></div></div><div class="binder-body"><span class="binder-title">Coleção principal</span><small>96 cartas · 12 páginas</small><div class="binder-actions"><button class="secondary" onclick="openModal('binder-card')">Abrir</button><button class="primary" onclick="openModal('binder-card')">＋ Carta</button></div></div></div><div class="binder"><div class="binder-cover yellow"><div class="cover-ball"></div></div><div class="binder-body"><span class="binder-title">Favoritos</span><small>32 cartas · 4 páginas</small><div class="binder-actions"><button class="secondary" onclick="openModal('binder-card')">Abrir</button><button class="primary" onclick="openModal('binder-card')">＋ Carta</button></div></div></div><div class="binder"><div class="binder-cover blue"><div class="cover-ball"></div></div><div class="binder-body"><span class="binder-title">Trocas 2026</span><small>18 cartas · 3 páginas</small><div class="binder-actions"><button class="secondary" onclick="openModal('binder-card')">Abrir</button><button class="primary" onclick="openModal('binder-card')">＋ Carta</button></div></div></div><button class="add-tile" onclick="openModal('binder')"><span>＋</span><b>Criar novo fichário</b><small>Comece uma nova organização</small></button></div></section>

    <section id="trades" class="screen"><div class="row"><div><p class="eyebrow">Encontre sua próxima carta</p><h1>Trocas</h1><p class="muted">Ofereça o que você tem e encontre o que deseja.</p></div><button class="primary" onclick="openModal('offer')">＋ Fazer oferta</button></div><div class="stat-grid"><div class="stat"><strong>12</strong><span>cartas ofertadas</span></div><div class="stat"><strong>4</strong><span>ofertas recebidas</span></div><div class="stat"><strong>8</strong><span>cartas desejadas</span></div></div><div class="tabs"><button class="tab active">Explorar ofertas</button><button class="tab">Minhas cartas</button><button class="tab" onclick="openModal('wishlist')">Lista de desejos</button></div><div class="offer-grid"><div class="offer"><div class="person"><span class="avatar">MC</span><span><b>Marina Costa</b><small class="muted">há 2 horas</small></span></div><div class="exchange"><div><div class="trade-card">M</div><small>Quer Mew ex</small></div><b class="red" style="font-size:25px">⇄</b><div><div class="trade-card" style="border-color:#d92735">C</div><small>Oferece Charizard</small></div></div><button class="secondary" style="width:100%" onclick="openModal('offer')">Ver oferta</button></div><div class="offer"><div class="person"><span class="avatar">LT</span><span><b>Lucas TCG</b><small class="muted">há 5 minutos</small></span></div><div class="exchange"><div><div class="trade-card" style="border-color:#f1bd25">P</div><small>Quer Pikachu</small></div><b class="red" style="font-size:25px">⇄</b><div><div class="trade-card" style="border-color:#b98961">E</div><small>Oferece Eevee</small></div></div><button class="secondary" style="width:100%" onclick="openModal('offer')">Ver oferta</button></div><div class="offer"><div class="person"><span class="avatar">AC</span><span><b>Ana Coleciona</b><small class="muted">há 1 hora</small></span></div><div class="exchange"><div><div class="trade-card" style="border-color:#7959a9">G</div><small>Quer Gengar</small></div><b class="red" style="font-size:25px">⇄</b><div><div class="trade-card" style="border-color:#5ea276">B</div><small>Oferece Bulbasaur</small></div></div><button class="secondary" style="width:100%" onclick="openModal('offer')">Ver oferta</button></div></div></section>

    <section id="profile" class="screen"><div class="profile-card"><div class="profile-avatar">G</div><div style="flex:1"><h1 style="font-size:30px">Guilherme Camargo</h1><p class="muted">@guicamarg0 · colecionador desde 2026</p><div class="profile-stats"><span><strong>128</strong><small>cartas</small></span><span><strong>3</strong><small>fichários</small></span><span><strong>12</strong><small>amigos</small></span></div></div><button class="secondary" onclick="openModal('profile')">Editar perfil</button></div><div class="profile-columns"><div class="panel"><div class="section-header"><h2>Meus amigos</h2><button class="link" onclick="openModal('friend')">＋ Adicionar</button></div><div class="friend"><span class="avatar">MC</span><div><b>Marina Costa</b><small class="muted">@marina.cards</small></div><small class="muted">online</small></div><div class="friend"><span class="avatar">LT</span><div><b>Lucas TCG</b><small class="muted">@lucastcg</small></div><small class="muted">há 5 min</small></div><div class="friend"><span class="avatar">AC</span><div><b>Ana Coleciona</b><small class="muted">@anacoleciona</small></div><small class="muted">há 1 h</small></div></div><div class="panel"><h2>Privacidade</h2><p class="muted" style="margin-top:7px">Controle quem pode ver sua coleção.</p><div class="toggle-row">Perfil público <span class="switch"><i></i></span></div><div class="toggle-row">Aceitar ofertas <span class="switch"><i></i></span></div><div class="toggle-row">Atividade recente <span class="switch" style="background:#d8dde3"><i style="margin-left:0"></i></span></div></div></div></section>
  </main>

  <nav class="bottom-nav"><button class="nav-button active" data-section="home" onclick="navigate('home')"><span class="nav-icon">⌂</span>Início</button><button class="nav-button" data-section="binders" onclick="navigate('binders')"><span class="nav-icon">▣</span>Fichários</button><button class="nav-button" data-section="trades" onclick="navigate('trades')"><span class="nav-icon">⇄</span>Trocas</button><button class="nav-button" data-section="profile" onclick="navigate('profile')"><span class="nav-icon">♙</span>Perfil</button></nav>

  <div id="modal" class="modal-bg hidden" onclick="closeModal(event)"><div id="modal-card" class="modal"></div></div>
  <script>
    var selectedSlot = 0;
    function navigate(section) { var screens = document.getElementsByClassName('screen'), buttons = document.getElementsByClassName('nav-button'), i; for (i = 0; i < screens.length; i++) screens[i].className = screens[i].className.replace(' active', ''); document.getElementById(section).className += ' active'; for (i = 0; i < buttons.length; i++) buttons[i].className = buttons[i].className.replace(' active', ''); var active = document.querySelector('[data-section="' + section + '"]'); if (active) active.className += ' active'; window.scrollTo(0, 0); }
    function closeModal(event) { if (!event || event.target.id === 'modal') document.getElementById('modal').className = 'modal-bg hidden'; }
    function openModal(type) { var html = ''; if (type === 'card') html = '<div class="modal-head"><div><h2>Adicionar carta</h2><p class="muted" style="margin-top:5px">Encontre uma carta ou registre uma cópia.</p></div><button class="close" onclick="closeModal()">×</button></div><div class="form-row"><label>Buscar carta</label><input placeholder="Nome, coleção ou número" /></div><div class="selected-card"><div class="thumb">P</div><div><b>Pikachu</b><p class="muted" style="margin-top:4px">151 · #025</p></div></div><button class="primary" onclick="closeModal()">Adicionar à minha coleção</button>';
      if (type === 'binder') html = '<div class="modal-head"><div><h2>Novo fichário</h2><p class="muted" style="margin-top:5px">Crie um espaço para organizar suas cartas.</p></div><button class="close" onclick="closeModal()">×</button></div><div class="form-row"><label>Nome</label><input value="Meu novo fichário" /></div><div class="form-row"><label>Quantidade de páginas</label><input type="number" value="4" /></div><div class="form-row"><label>Visibilidade</label><select><option>Privado</option><option>Compartilhado por link</option></select></div><button class="primary" onclick="closeModal()">Criar fichário</button>';
      if (type === 'binder-card') html = '<div class="modal-head"><div><h2>Adicionar ao fichário</h2><p class="muted" style="margin-top:5px">Escolha a quantidade e a posição desta carta.</p></div><button class="close" onclick="closeModal()">×</button></div><div class="selected-card"><div class="thumb">P</div><div><b>Pikachu</b><p class="muted" style="margin-top:4px">151 · #025</p><p class="red" style="margin-top:7px;font-size:12px;font-weight:bold">Você possui 5 cópias · 3 disponíveis</p></div></div><div class="form-row"><label>Quantidade</label><div class="stepper"><button onclick="changeQty(-1)">−</button><strong id="qty">2</strong><button onclick="changeQty(1)">＋</button></div></div><div class="form-row"><label>Escolha a posição · Página 1 de 4</label><div class="slot-grid">' + slotButtons() + '</div></div><button class="primary" onclick="closeModal()">▣ Adicionar ao fichário</button>';
      if (type === 'offer') html = '<div class="modal-head"><div><h2>Fazer oferta</h2><p class="muted" style="margin-top:5px">Monte uma proposta para outro colecionador.</p></div><button class="close" onclick="closeModal()">×</button></div><div class="form-row"><label>Você oferece</label><div class="selected-card"><div class="thumb">C</div><div><b>Charizard</b><p class="muted">Disponível na sua coleção</p></div></div></div><div class="form-row"><label>Você deseja receber</label><div class="selected-card"><div class="thumb" style="border-color:#a884d7">M</div><div><b>Mew ex</b><p class="muted">Da lista de desejos</p></div></div></div><div class="form-row"><label>Mensagem opcional</label><input placeholder="Escreva uma mensagem..." /></div><button class="primary" onclick="closeModal()">⇄ Enviar proposta</button>';
      if (type === 'friend') html = '<div class="modal-head"><div><h2>Adicionar amigo</h2><p class="muted" style="margin-top:5px">Encontre colecionadores pelo nome de usuário.</p></div><button class="close" onclick="closeModal()">×</button></div><div class="form-row"><label>Nome de usuário</label><input placeholder="ex.: treinador_ash" /></div><div class="selected-card"><div><b>🔒 Privacidade primeiro</b><p class="muted" style="margin-top:4px">Você decide quais fichários e cartas compartilhar.</p></div></div><button class="primary" onclick="closeModal()">Enviar solicitação</button>';
      if (type === 'profile') html = '<div class="modal-head"><div><h2>Editar perfil</h2><p class="muted" style="margin-top:5px">Atualize as informações do seu perfil.</p></div><button class="close" onclick="closeModal()">×</button></div><div class="form-row"><label>Nome</label><input value="Guilherme Camargo" /></div><div class="form-row"><label>Nome de usuário</label><input value="guicamarg0" /></div><button class="primary" onclick="closeModal()">Salvar alterações</button>';
      if (type === 'wishlist') html = '<div class="modal-head"><div><h2>Lista de desejos</h2><p class="muted" style="margin-top:5px">Cartas que você quer receber.</p></div><button class="close" onclick="closeModal()">×</button></div><div class="selected-card"><div class="thumb" style="border-color:#a884d7">M</div><div><b>Mew ex</b><p class="muted">151 · #193</p></div></div><div class="selected-card"><div class="thumb" style="border-color:#7959a9">G</div><div><b>Gengar</b><p class="muted">Crepúsculo · #057</p></div></div><button class="primary" onclick="closeModal()">＋ Adicionar carta desejada</button>';
      document.getElementById('modal-card').innerHTML = html; document.getElementById('modal').className = 'modal-bg';
    }
    function slotButtons() { var html = '', i; for (i = 0; i < 9; i++) html += '<button class="slot ' + (i === selectedSlot ? 'selected' : '') + '" onclick="selectSlot(' + i + ')">' + (i === selectedSlot ? '✓' : '+') + '</button>'; return html; }
    function selectSlot(index) { selectedSlot = index; openModal('binder-card'); }
    function changeQty(delta) { var element = document.getElementById('qty'), value = parseInt(element.innerHTML, 10) + delta; if (value > 0 && value < 4) element.innerHTML = value; }
  </script>
</body>
</html>
